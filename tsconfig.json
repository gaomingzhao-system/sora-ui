{
  // Node-side tooling: scripts, tool configs and ui.config.ts.
  // No DOM lib on purpose: a script that touches `document` is a mistake.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext"]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/e2e/ports.ts",
    "ui.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "packages/ui/src/compiled-messages.d.ts"
  ]
}

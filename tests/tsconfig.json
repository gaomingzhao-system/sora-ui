{
  // Browser-side tests: Vapor fixtures, component tests and the type tests.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "@vitest/browser-playwright"]
  },
  "include": [
    "browser/**/*.ts",
    "browser/**/*.vue",
    "fixtures/compat/**/*.ts",
    "fixtures/compat/**/*.vue",
    "helpers/**/*.ts",
    "types/**/*.ts",
    "types/**/*.vue",
    "../packages/ui/src/env.d.ts",
    "../packages/ui/src/compiled-messages.d.ts"
  ]
}

{
  "name": "sora-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Vue Vapor UI component library workspace (@your-scope/ui and @your-scope/theme).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:theme && pnpm --filter @your-scope/gallery dev",
    "generate:theme": "node scripts/generate-theme.ts",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "typecheck": "node scripts/typecheck.ts",
    "check:vapor": "node scripts/check-vapor.ts",
    "check:locales": "node scripts/check-locales.ts",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "build": "pnpm generate:theme && pnpm --filter @your-scope/theme build && pnpm --filter @your-scope/ui build && pnpm --filter @your-scope/gallery build",
    "test:e2e": "playwright test",
    "test:types": "node scripts/test-types.ts",
    "check:package": "node scripts/check-package.ts",
    "verify:consumer": "node scripts/verify-consumer.ts",
    "measure:bundle": "node scripts/measure-bundle.ts",
    "docs:components": "node scripts/generate-docs.ts",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm build && pnpm check:package && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@changesets/cli": "catalog:",
    "@formisch/vue": "catalog:",
    "@intlify/message-compiler": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@your-scope/theme": "workspace:*",
    "@your-scope/ui": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "petite-vue-i18n": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "packageManager": "pnpm@12.21.0"
}
